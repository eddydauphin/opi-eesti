        {
          "id": "u1l3",
          "title": "Mina olen",
          "tip": {
            "en": "\"Mina olen\" (I am) and \"sina oled\" (you are). In everyday speech people shorten the pronouns to \"ma\" and \"sa\". \"Sina\" is the informal you; use \"teie\" with strangers and officials.",
            "fr": "« Mina olen » (je suis) et « sina oled » (tu es). À l'oral, on raccourcit les pronoms en « ma » et « sa ». « Sina » est le tutoiement ; avec les inconnus et l'administration, on dit « teie ».",
            "es": "«Mina olen» (yo soy) y «sina oled» (tú eres). Al hablar, los pronombres se acortan a «ma» y «sa». «Sina» es el tuteo; con desconocidos y en trámites se usa «teie»."
          },
          "words": [
            {
              "et": "mina",
              "en": "I",
              "fr": "je",
              "es": "yo",
              "alt_fr": [
                "moi"
              ]
            },
            {
              "et": "sina",
              "en": "you",
              "fr": "tu",
              "es": "tú",
              "alt_fr": [
                "toi"
              ]
            },
            {
              "et": "olen",
              "en": "am",
              "fr": "suis",
              "es": "soy"
            },
            {
              "et": "oled",
              "en": "are",
              "fr": "es",
              "es": "eres"
            },
            {
              "et": "on",
              "en": "is",
              "fr": "est",
              "es": "es"
            },
            {
              "et": "minu nimi",
              "en": "my name",
              "fr": "mon nom",
              "es": "mi nombre"
            },
            {
              "et": "kes",
              "en": "who",
              "fr": "qui",
              "es": "quién"
            }
          ],
          "sentences": [
            {
              "et": "Mina olen Eddy.",
              "en": "I am Eddy.",
              "fr": "Je suis Eddy.",
              "es": "Yo soy Eddy.",
              "alt_es": [
                "Soy Eddy."
              ]
            },
            {
              "et": "Kes sina oled?",
              "en": "Who are you?",
              "fr": "Qui es-tu ?",
              "es": "¿Quién eres tú?",
              "alt_fr": [
                "Tu es qui ?"
              ],
              "alt_es": [
                "¿Quién eres?"
              ]
            },
            {
              "et": "Minu nimi on Anna.",
              "en": "My name is Anna.",
              "fr": "Mon nom est Anna.",
              "es": "Mi nombre es Anna.",
              "alt_fr": [
                "Je m'appelle Anna."
              ],
              "alt_es": [
                "Me llamo Anna."
              ]
            },
            {
              "et": "Sina oled Mari.",
              "en": "You are Mari.",
              "fr": "Tu es Mari.",
              "es": "Tú eres Mari.",
              "alt_es": [
                "Eres Mari."
              ]
            },
            {
              "et": "Tere, mina olen Eddy.",
              "en": "Hello, I am Eddy.",
              "fr": "Bonjour, je suis Eddy.",
              "es": "Hola, yo soy Eddy.",
              "alt_fr": [
                "Salut, je suis Eddy."
              ],
              "alt_es": [
                "Hola, soy Eddy."
              ]
            }
          ]
        }
      ]
